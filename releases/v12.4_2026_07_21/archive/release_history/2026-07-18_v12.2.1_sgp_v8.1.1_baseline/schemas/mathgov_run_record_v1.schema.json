{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathgov.org/schemas/mathgov_run_record_v1.schema.json",
  "title": "MathGov Reproducible Run Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "decision",
    "profile_and_stakes",
    "evidence_and_claim_boundary",
    "parameter_lock",
    "stakeholders",
    "options",
    "gate_results",
    "ranking",
    "decision_state",
    "authority_and_execution",
    "controls_monitoring_and_reopen",
    "audit_and_signoff"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_version",
        "package_release_id",
        "canon_version",
        "created_utc"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_version": {
          "type": "string",
          "minLength": 1
        },
        "parent_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_release_id": {
          "type": "string",
          "minLength": 1
        },
        "package_sha256_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "canon_version": {
          "const": "v12.2.1"
        },
        "sgp_version": {
          "enum": [
            "v8.1.1",
            "NOT_TRIGGERED"
          ]
        },
        "created_utc": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "baseline",
        "option_ids"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "option_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "no_action_or_delay_option": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "profile_and_stakes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "profile",
        "stakes",
        "reversibility",
        "public_claim"
      ],
      "properties": {
        "tier": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "profile": {
          "enum": [
            "QUICK",
            "STANDARD",
            "AUDIT"
          ]
        },
        "stakes": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CATASTROPHIC_POSSIBLE"
          ]
        },
        "reversibility": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "IRREVERSIBLE"
          ]
        },
        "public_claim": {
          "type": "boolean"
        },
        "escalation_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_and_claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reality_surface",
        "evidence_trace",
        "material_unknowns",
        "consequence_pathways",
        "claim_boundary",
        "rg_status"
      ],
      "properties": {
        "reality_surface": {
          "type": "string",
          "minLength": 1
        },
        "evidence_trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "description",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "PRIMARY",
                  "SECONDARY",
                  "EXPERT",
                  "TESTIMONY",
                  "MODEL",
                  "ASSUMPTION"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "material_unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consequence_pathways": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        },
        "rg_status": {
          "enum": [
            "GROUNDED",
            "ESTIMATED",
            "ASSUMPTION_BOUND",
            "DECLARED_UNKNOWN",
            "OUT_OF_SCOPE_WITH_RATIONALE",
            "INSUFFICIENT_GROUNDING"
          ]
        }
      }
    },
    "parameter_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locked",
        "locked_utc",
        "evidence_cutoff_utc",
        "parameters",
        "amendment_policy"
      ],
      "properties": {
        "locked": {
          "const": true
        },
        "locked_utc": {
          "type": "string",
          "minLength": 1
        },
        "evidence_cutoff_utc": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "status",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {},
              "status": {
                "enum": [
                  "CANON_DEFAULT",
                  "DOMAIN_STANDARD",
                  "EMPIRICALLY_ESTIMATED",
                  "EXPERT_JUDGMENT",
                  "PARTICIPATORY_CHOICE",
                  "CONSERVATIVE_BOUND",
                  "ASSUMPTION_BOUND",
                  "UNKNOWN",
                  "NOT_MATERIAL"
                ]
              },
              "source": {
                "type": "string"
              },
              "used_in_arithmetic": {
                "type": "boolean"
              },
              "not_material_rationale": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "amendment_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stakeholders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "union_scopes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "union_scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "U1",
                "U2",
                "U3",
                "U4",
                "U5",
                "U6",
                "U7"
              ]
            }
          },
          "subgroup": {
            "type": [
              "string",
              "null"
            ]
          },
          "sgp_record_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "gate_results": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "rg",
          "rf",
          "trc",
          "csv",
          "selectable"
        ],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "rg": {
            "enum": [
              "RG_SUPPORTED",
              "RG_NARROWED",
              "RG_REFUSED"
            ]
          },
          "rf": {
            "enum": [
              "RF_PASS",
              "RF_FAIL",
              "RF_ESCALATE"
            ]
          },
          "trc": {
            "enum": [
              "TRC_PASS",
              "TRC_FAIL",
              "TRC_ESCALATE",
              "TRC_NOT_EVALUATED_AFTER_PRIOR_FAILURE"
            ]
          },
          "csv": {
            "enum": [
              "CSV_PASS",
              "CSV_PASS_WITH_CONTROLS",
              "CSV_NOT_MATERIAL",
              "CSV_FAIL",
              "CSV_REDESIGN",
              "CSV_ESCALATE",
              "CSV_NOT_EVALUATED_AFTER_PRIOR_FAILURE"
            ]
          },
          "selectable": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "ranked_option_ids",
        "decisive",
        "sensitivity_status"
      ],
      "properties": {
        "method": {
          "enum": [
            "QUALITATIVE_TIER1",
            "RLS_DECLARED_METHOD",
            "NOT_APPLICABLE"
          ]
        },
        "ranked_option_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "decisive": {
          "type": "boolean"
        },
        "decisiveness_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "sensitivity_status": {
          "enum": [
            "NOT_MATERIAL",
            "ROBUST",
            "HYPOTHESIS_SENSITIVE",
            "PARAMETER_SENSITIVE",
            "NOT_EVALUATED"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "decision_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "selected_option_id",
        "rationale"
      ],
      "properties": {
        "state": {
          "enum": [
            "SELECTED_DECISIVE",
            "SELECTED_BY_AUTHORITY_NON_DECISIVE",
            "PROVISIONAL_WITH_CONTROLS",
            "DELAY",
            "REDESIGN",
            "ESCALATE",
            "REFUSE",
            "NO_SELECTABLE_OPTION",
            "EMERGENCY_PROVISIONAL"
          ]
        },
        "selected_option_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "authority_selection_rationale": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "authority_and_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_basis_present",
        "authority_role",
        "mandate_scope",
        "execution_state"
      ],
      "properties": {
        "authority_basis_present": {
          "type": "boolean"
        },
        "authority_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "mandate_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "appeal_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "revocation_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution_state": {
          "enum": [
            "NOT_AUTHORIZED",
            "AUTHORIZED_WITHIN_SCOPE",
            "EXECUTION_BLOCKED",
            "EXECUTED_UNDER_MONITORING"
          ]
        }
      }
    },
    "controls_monitoring_and_reopen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls",
        "monitoring",
        "reopen_triggers",
        "material_change_requires_requalification"
      ],
      "properties": {
        "controls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monitoring": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "shutdown_or_pause_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "reopen_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "material_change_requires_requalification": {
          "const": true
        }
      }
    },
    "audit_and_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewers",
        "conflicts_disclosed",
        "record_status"
      ],
      "properties": {
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts_disclosed": {
          "type": "boolean"
        },
        "independent_replay_status": {
          "enum": [
            "NOT_RUN",
            "REPLAY_MATCH",
            "REPLAY_CONDITIONALLY_MATCHES",
            "REPLAY_DIVERGES",
            "REPLAY_INADMISSIBLE"
          ]
        },
        "record_status": {
          "enum": [
            "DRAFT",
            "LOCKED",
            "SUPERSEDED",
            "CLOSED"
          ]
        },
        "record_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
