{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ripplelogic.org/schemas/wdbip_record_v1_5.schema.json",
  "title": "WDBIP Record v1.5",
  "type": "object",
  "required": [
    "protocol_version",
    "schema_version",
    "welfare_dimension_set_version",
    "canon_version",
    "pcc_link",
    "run_id",
    "option_id",
    "baseline",
    "tier",
    "use_class",
    "declared_scopes",
    "population",
    "time_window_alignment",
    "subgroup_review",
    "weight_sensitivity",
    "dimension_migration",
    "effect_tokens",
    "record_status"
  ],
  "properties": {
    "protocol_version": {
      "const": "WDBIP v1.5"
    },
    "schema_version": {
      "const": "wdbip_record_v1_5"
    },
    "canon_version": {
      "const": "RippleLogic v12.5"
    },
    "sgp_link": {
      "type": "object",
      "required": [
        "applicable"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        },
        "record_ref": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "pcc_link": {
      "type": "object",
      "required": [
        "pcc_record_id",
        "wdbip_record_id",
        "attachment_mode"
      ],
      "properties": {
        "pcc_record_id": {
          "type": "string",
          "minLength": 1
        },
        "wdbip_record_id": {
          "type": "string",
          "minLength": 1
        },
        "record_hash": {
          "type": "string"
        },
        "artifact_locator": {
          "type": "string"
        },
        "attachment_mode": {
          "enum": [
            "PCC_EMBEDDED",
            "PCC_HASH_REFERENCED",
            "PCC_IMMUTABLE_LOCATOR"
          ]
        },
        "unresolved_boundary_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gate_routing_summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "option_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "string",
      "minLength": 1
    },
    "declared_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "U1_SELF",
          "U2_HOUSEHOLD",
          "U3_COMMUNITY",
          "U4_ORGANIZATION",
          "U5_POLITY",
          "U6_HUMANITY_GLOBAL_COORDINATION",
          "U7_BIOSPHERE"
        ]
      }
    },
    "scope_mode": {
      "enum": [
        "FULL_SCOPE",
        "REDUCED_SCOPE"
      ]
    },
    "scope_coverage_declaration_ref": {
      "type": "string"
    },
    "population": {
      "type": "string",
      "minLength": 1
    },
    "time_horizon": {
      "type": "string"
    },
    "effect_tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "token_id",
          "claim",
          "primary_dimension",
          "boundary_status",
          "scope_assignment",
          "bearer",
          "time_window",
          "evidence_status",
          "uncertainty"
        ],
        "properties": {
          "token_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "primary_dimension": {
            "enum": [
              "D1_MATERIAL",
              "D2_HEALTH",
              "D3_SOCIAL",
              "D4_KNOWLEDGE",
              "D5_AGENCY",
              "D6_MEANING",
              "D7_ENVIRONMENT"
            ]
          },
          "boundary_status": {
            "enum": [
              "BOUNDARY_RESOLVED",
              "BOUNDARY_CONTESTED",
              "BOUNDARY_UNKNOWN",
              "BOUNDARY_NOT_MATERIAL"
            ]
          },
          "scope_assignment": {
            "type": "object",
            "required": [
              "represented_scopes",
              "redundancy_method",
              "rationale"
            ],
            "properties": {
              "primary_scope": {
                "enum": [
                  "U1_SELF",
                  "U2_HOUSEHOLD",
                  "U3_COMMUNITY",
                  "U4_ORGANIZATION",
                  "U5_POLITY",
                  "U6_HUMANITY_GLOBAL_COORDINATION",
                  "U7_BIOSPHERE"
                ]
              },
              "represented_scopes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "U1_SELF",
                    "U2_HOUSEHOLD",
                    "U3_COMMUNITY",
                    "U4_ORGANIZATION",
                    "U5_POLITY",
                    "U6_HUMANITY_GLOBAL_COORDINATION",
                    "U7_BIOSPHERE"
                  ]
                }
              },
              "redundancy_method": {
                "enum": [
                  "EMERGENT_SCALE_JUSTIFICATION",
                  "DEDUPLICATION",
                  "ALLOCATION",
                  "NOT_APPLICABLE"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "allocation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "scope",
                    "coefficient"
                  ],
                  "properties": {
                    "scope": {
                      "enum": [
                        "U1_SELF",
                        "U2_HOUSEHOLD",
                        "U3_COMMUNITY",
                        "U4_ORGANIZATION",
                        "U5_POLITY",
                        "U6_HUMANITY_GLOBAL_COORDINATION",
                        "U7_BIOSPHERE"
                      ]
                    },
                    "coefficient": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "allocation_residual": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "allocation_residual_status": {
                "enum": [
                  "NO_RESIDUAL",
                  "JUSTIFIED_ATTENUATION",
                  "OUT_OF_BOUNDARY_REMAINDER",
                  "MEASUREMENT_LOSS",
                  "UNRESOLVED_ALLOCATION"
                ]
              },
              "allocation_residual_rationale": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "bearer": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": "string"
          },
          "evidence_status": {
            "enum": [
              "EVIDENCE_DIRECT_OBSERVATION",
              "EVIDENCE_VALIDATED_INSTRUMENT",
              "EVIDENCE_EMPIRICALLY_ESTIMATED",
              "EVIDENCE_EXPERT_JUDGMENT",
              "EVIDENCE_PARTICIPATORY",
              "EVIDENCE_QUALITATIVE_CODED",
              "EVIDENCE_HYPOTHESIZED",
              "EVIDENCE_CONTESTED",
              "EVIDENCE_UNKNOWN",
              "EVIDENCE_NOT_MATERIAL"
            ]
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string"
              },
              "functioning": {
                "type": "string"
              },
              "capacity_resilience": {
                "type": "string"
              },
              "drivers_enabling_conditions": {
                "type": "string"
              },
              "lived_experience": {
                "type": "string"
              },
              "distribution_worst_affected": {
                "type": "string"
              },
              "uncertainty_evidence_status": {
                "type": "string"
              },
              "aggregate_sign": {
                "enum": [
                  "BENEFICIAL",
                  "HARMFUL",
                  "MIXED",
                  "UNKNOWN",
                  "NOT_APPLICABLE"
                ]
              },
              "worst_subgroup_sign": {
                "enum": [
                  "BENEFICIAL",
                  "HARMFUL",
                  "MIXED",
                  "UNKNOWN",
                  "NOT_APPLICABLE"
                ]
              },
              "worst_affected_subgroups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "not_material_rationale": {
            "type": "string",
            "minLength": 1
          },
          "reopen_trigger": {
            "type": "string",
            "minLength": 1
          },
          "time_window": {
            "type": "object",
            "required": [
              "window_id",
              "period",
              "state_timing"
            ],
            "properties": {
              "window_id": {
                "type": "string",
                "minLength": 1
              },
              "period": {
                "type": "string",
                "minLength": 1
              },
              "state_timing": {
                "enum": [
                  "BASELINE",
                  "IMMEDIATE",
                  "SHORT_TERM",
                  "MEDIUM_TERM",
                  "LONG_TERM",
                  "MULTI_PERIOD"
                ]
              },
              "lag_note": {
                "type": "string"
              },
              "duration_note": {
                "type": "string"
              },
              "reversibility_note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path_id",
          "source_token",
          "target_token",
          "pathway_type",
          "scope_relation",
          "direction",
          "evidence_status",
          "uncertainty"
        ],
        "properties": {
          "path_id": {
            "type": "string",
            "minLength": 1
          },
          "source_token": {
            "type": "string",
            "minLength": 1
          },
          "target_token": {
            "type": "string",
            "minLength": 1
          },
          "pathway_type": {
            "enum": [
              "PATHWAY_CAUSAL_DIRECT",
              "PATHWAY_CAUSAL_MEDIATED",
              "PATHWAY_ENABLING_CONDITION",
              "PATHWAY_MODERATOR",
              "PATHWAY_FEEDBACK",
              "PATHWAY_SHARED_CAUSE",
              "PATHWAY_CORRELATIONAL_ONLY",
              "PATHWAY_HYPOTHESIZED",
              "PATHWAY_CONTESTED",
              "PATHWAY_UNKNOWN",
              "PATHWAY_NOT_MATERIAL"
            ]
          },
          "scope_relation": {
            "enum": [
              "SAME_SCOPE",
              "CROSS_SCOPE",
              "NESTED_SCOPE",
              "FEEDBACK_ACROSS_SCOPES",
              "SCOPE_RELATION_UNKNOWN"
            ]
          },
          "mechanism": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "DIRECTION_BENEFICIAL",
              "DIRECTION_HARMFUL",
              "DIRECTION_MIXED",
              "DIRECTION_NONLINEAR",
              "DIRECTION_UNKNOWN"
            ]
          },
          "time_lag": {
            "type": "string"
          },
          "magnitude": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "evidence_status": {
            "enum": [
              "EVIDENCE_DIRECT_OBSERVATION",
              "EVIDENCE_VALIDATED_INSTRUMENT",
              "EVIDENCE_EMPIRICALLY_ESTIMATED",
              "EVIDENCE_EXPERT_JUDGMENT",
              "EVIDENCE_PARTICIPATORY",
              "EVIDENCE_QUALITATIVE_CODED",
              "EVIDENCE_HYPOTHESIZED",
              "EVIDENCE_CONTESTED",
              "EVIDENCE_UNKNOWN",
              "EVIDENCE_NOT_MATERIAL"
            ]
          },
          "alternative_explanations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          },
          "not_material_rationale": {
            "type": "string",
            "minLength": 1
          },
          "reopen_trigger": {
            "type": "string",
            "minLength": 1
          },
          "source_window_id": {
            "type": "string"
          },
          "target_window_id": {
            "type": "string"
          },
          "temporal_model_ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dependence_review": {
      "type": "object"
    },
    "routing": {
      "type": "object"
    },
    "record_status": {
      "enum": [
        "WDBIP_RECORD_COMPLETE",
        "WDBIP_RECORD_COMPLETE_WITH_UNCERTAINTY",
        "WDBIP_RECORD_INCOMPLETE",
        "WDBIP_RECORD_NOT_MATERIAL"
      ]
    },
    "not_material_rationale": {
      "type": "string"
    },
    "reopen_trigger": {
      "type": "string"
    },
    "reviewer": {
      "type": "object"
    },
    "welfare_dimension_set_version": {
      "const": "WELFARE_DIMENSION_SET_7D_V1"
    },
    "tier": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "use_class": {
      "enum": [
        "SINGLE_RUN",
        "REPEATED_INSTITUTIONAL_USE",
        "VALIDATION_STUDY"
      ]
    },
    "time_window_alignment": {
      "type": "object",
      "required": [
        "status",
        "baseline_period",
        "comparison_horizon"
      ],
      "properties": {
        "status": {
          "enum": [
            "TIME_ALIGNED",
            "TIME_MODEL_DECLARED",
            "TIME_MISMATCH_UNRESOLVED"
          ]
        },
        "baseline_period": {
          "type": "string",
          "minLength": 1
        },
        "comparison_horizon": {
          "type": "string",
          "minLength": 1
        },
        "temporal_model_ref": {
          "type": "string"
        },
        "mismatch_rationale": {
          "type": "string"
        },
        "sensitivity_ref": {
          "type": "string"
        },
        "monitoring_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reopen_trigger": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "subgroup_review": {
      "type": "object",
      "required": [
        "completed",
        "aggregate_sign",
        "worst_subgroup_sign",
        "worst_affected_subgroups",
        "severe_harm_status"
      ],
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "aggregate_sign": {
          "enum": [
            "BENEFICIAL",
            "HARMFUL",
            "MIXED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "worst_subgroup_sign": {
          "enum": [
            "BENEFICIAL",
            "HARMFUL",
            "MIXED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "worst_affected_subgroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severe_harm_status": {
          "enum": [
            "NONE_IDENTIFIED",
            "RESIDUAL_WELFARE_HARM",
            "RIGHTS_MATERIAL",
            "TRC_MATERIAL",
            "CSV_MATERIAL",
            "UNKNOWN"
          ]
        },
        "gate_routing_ref": {
          "type": "string"
        },
        "masking_review_completed": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "weight_sensitivity": {
      "type": "object",
      "required": [
        "material",
        "status"
      ],
      "properties": {
        "material": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "NOT_MATERIAL",
            "WEIGHT_ROBUST",
            "WEIGHT_SENSITIVE",
            "NOT_TESTED",
            "UNKNOWN"
          ]
        },
        "tested_weight_sets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analysis_ref": {
          "type": "string"
        },
        "authority_selection_ref": {
          "type": "string"
        },
        "not_material_rationale": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dimension_migration": {
      "type": "object",
      "required": [
        "applicable",
        "record_dimension_set",
        "comparability_status"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "record_dimension_set": {
          "type": "string"
        },
        "target_dimension_set": {
          "type": "string"
        },
        "crosswalk_ref": {
          "type": "string"
        },
        "comparability_status": {
          "enum": [
            "COMPARABLE_AS_RECORDED",
            "COMPARABLE_WITH_BRIDGE_MODEL",
            "COMPARABLE_FOR_QUALITATIVE_TREND_ONLY",
            "NONCOMPARABLE",
            "NOT_APPLICABLE"
          ]
        },
        "rerun_required": {
          "type": "boolean"
        },
        "rerun_ref": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "boundary_reliability": {
      "type": "object",
      "required": [
        "applicable",
        "review_status"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "primary_dimension_agreement": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "pathway_type_agreement": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "scope_treatment_agreement": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "boundary_contested_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_interval_note": {
          "type": "string"
        },
        "statistic": {
          "type": "string"
        },
        "review_status": {
          "enum": [
            "NOT_APPLICABLE",
            "WITHIN_PREREGISTERED_TARGET",
            "REVIEW_TRIGGERED",
            "REVISION_REQUIRED",
            "NOT_EVALUATED"
          ]
        },
        "review_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
